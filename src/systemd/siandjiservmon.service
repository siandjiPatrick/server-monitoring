[Unit]
Description=Smart monitoring tool with modular scripts.
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/siandjiservmon
Restart=always
RestartSec=5

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
